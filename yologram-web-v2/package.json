{
  "name": "yologram-web-v2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start:dev": "APP_ENV=development next dev -p 6002",
    "build": "next build",
    "build:staging": "APP_ENV=staging env-cmd -f .env.staging next build",
    "build:prod": "APP_ENV=production env-cmd -f .env.production next build",
    "start": "APP_ENV=${APP_ENV:-development} next start -p 3000",
    "lint": "eslint"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.2.5",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
    "@opentelemetry/host-metrics": "^0.38.3",
    "@opentelemetry/instrumentation-http": "^0.217.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@tanstack/react-query": "^5.101.0",
    "antd": "^6.4.3",
    "axios": "^1.17.0",
    "jotai": "^2.20.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "env-cmd": "^11.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=24"
  }
}
